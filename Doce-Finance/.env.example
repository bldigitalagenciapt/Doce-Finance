# ─── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=seu-anon-key
# Somente servidor — NUNCA exponha com prefixo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Chave secreta (32+ caracteres) para criptografia AES-256-GCM dos dados sensíveis do usuário no banco
DATA_ENCRYPTION_KEY=gere-uma-chave-secreta-forte-de-32-bytes-aqui

# ─── App ──────────────────────────────────────────────────
# URL pública de produção, sem barra no final (usada nos retornos do Stripe)
NEXT_PUBLIC_APP_URL=https://doce-finance.vercel.app

# ─── Stripe (produção: sk_live_ / pk_live_) ───────────────
STRIPE_SECRET_KEY=sk_live_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_xxx
# Gerado ao criar o endpoint de webhook no Dashboard (whsec_...)
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Price IDs recorrentes criados no modo LIVE (price_...)
STRIPE_PRICE_BRL_MONTHLY=price_xxx
STRIPE_PRICE_BRL_YEARLY=price_xxx
STRIPE_PRICE_EUR_MONTHLY=price_xxx
STRIPE_PRICE_EUR_YEARLY=price_xxx
